ATLAS_ENV=development
# Run `python backend/scripts/setup.py` to choose a storage mode. SQLite is
# dependency-free; PostgreSQL is ideal for shared/team deployments.
ATLAS_STORAGE_MODE=sqlite
# Relative SQLite URLs are resolved against the Atlas install folder, not the
# shell's current directory. Setup writes an absolute install-local URL.
ATLAS_DATABASE_URL=sqlite:///./work/atlas.db
ATLAS_PROJECT_NAME=atlas-project
ATLAS_EMBEDDING_DIMENSIONS=1536
ATLAS_API_URL=http://localhost:8000
# Optional. By default Atlas only listens on this computer (127.0.0.1).
# Set to 0.0.0.0 only to let other devices on your network open the
# dashboard. Always set ATLAS_DASHBOARD_PIN first.
# ATLAS_API_HOST=0.0.0.0
ATLAS_AUTO_START_API=true
# Set automatically when setup option 1 manages local Docker PostgreSQL.
ATLAS_AUTO_START_DOCKER=false
# Optional. When set, Atlas API calls require this PIN header and the dashboard
# prompts for it before showing project memory. Keep unset for localhost-only
# development, or set before exposing Atlas on a local network.
# ATLAS_DASHBOARD_PIN=123456
# Optional. Without this, Atlas uses a deterministic local fallback: explicit
# decision capture, hashed local vectors, and lexical context curation. Add a
# key to upgrade automatically to model extraction, semantic embeddings, and
# model curation.
# ATLAS_OPENAI_API_KEY=sk-...
